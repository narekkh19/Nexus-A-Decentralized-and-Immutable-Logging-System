      "journal failure",
      "mounting failed",
      "disk quota exceeded",
      "inode exhaustion",
      "no space left on device",
      "device busy",
      "device error",
      "input/output error",
      "media failure",
      "firmware bug",
      "hardware error",
      "machine check error",
      "cpu overheating",
      "fan failure",
      "temperature threshold exceeded",
      "voltage out of range",
      "power supply failure",
      "battery failure",
      "acpi error",
      "bios error",
      "thermal event",
      "memory corruption",
      "dma error",
      "pci error",
      "usb enumeration failed",
      "device reset",
      "link down",
