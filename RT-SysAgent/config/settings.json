    "pattern_file_path": "tmp/pattern.txt"
  },
  "project": {
    "debug_mode": false,
    "name": "RT-SysAgent",
    "verbose_logging": false,
    "version": "1.0.0"
  },
  "queue": {
    "cache_line_size": 64,
    "max_retry_attempts": 10000,
    "size": 16384,
    "text_size": 256,
    "yield_sleep_ms": 1
  },
  "shared_memory": {
    "create_if_not_exists": true,
    "file_permissions": 438,
    "queue_file_path": "tmp/event_queue_shm"
  },
  "system_monitor": {
    "journald_path": "/var/log/journal",
    "syslog_buffer_size": 8192,
    "syslog_path": "/var/log/syslog",
    "usb_poll_timeout_ms": 500
  },
  "systemd": {
    "enable_integration": true,
    "service_description": "Real-Time System Monitoring Agent",
    "service_name": "rt-sysagent",
    "watchdog_timeout_ms": 200
  },
  "worker": {
    "flusher_sleep_ms": 1000,
    "log_threshold": 50,
    "monitor_poll_ms": 500,
    "num_workers": 4,
    "time_threshold_seconds": 4,
    "worker_sleep_ms": 1
  }
}